{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WACH",
  "version": "0.3.1",
  "identifier": "app.wach.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCREZGQzk0ODc4Qjk1OTYKUldTV2xZdUhsUHpmTzBHSE9iOEN0VEQ2Wk1MbUJWZnl2eWd5NFVHWHpsalRvK3B0dnpvaG1ENVIK",
      "endpoints": ["https://github.com/vincentrathbone-web/wach/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
